{
  "manifest_version": 3,
  "name": "Bookmark Compass",
  "version": "0.1.0",
  "description": "用浏览器本地 AI 为当前网页推荐合适的收藏夹位置。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["bookmarks", "activeTab", "scripting"],
  "key": "",
  "action": {
    "default_title": "保存到收藏夹",
    "default_popup": "popup.html"
  }
}
